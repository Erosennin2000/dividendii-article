{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.dividendii.com/api/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.dividendii.com/uploads/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.dividendii.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://api.dividendii.com/robots.txt"
    },
    {
      "source": "/learn",
      "destination": "/api/seo?type=learn"
    },
    {
      "source": "/learn/:slug",
      "destination": "/api/seo?type=article&slug=:slug"
    },
    {
      "source": "/check",
      "destination": "https://dividendiicheck21registrars.vercel.app/check"
    },
    {
      "source": "/check/:path*",
      "destination": "https://dividendiicheck21registrars.vercel.app/check/:path*"
    },
    {
      "source": "/((?!api/|assets/|uploads/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}